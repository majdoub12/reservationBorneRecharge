# Roboflow API configuration (get from https://app.roboflow.com/settings/api)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=carte_grise_detection/3

# Server deployment settings
HOST=127.0.0.1
PORT=8000

# PaddleOCR language and hardware settings (optional)
OCR_LANG=en
OCR_USE_GPU=false
