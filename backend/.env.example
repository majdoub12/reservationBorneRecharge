# Supabase / PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@host:port/database

# JWT secret key for signing session tokens
JWT_SECRET=your_jwt_secret_key_here

# SMTP configuration for email OTP and notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# Twilio API credentials for WhatsApp / SMS OTP
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Roboflow API configuration for OCR and object detection
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Keycloak Identity Provider Settings
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vehicle-app
KEYCLOAK_CLIENT_ID=frontend-spa
